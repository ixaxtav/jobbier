# Postgres connection string (Neon pooled URL in production)
DATABASE_URL=postgres://localhost:5432/jobbier_dev
# Optional: direct (unpooled) URL used for migrations
DATABASE_URL_UNPOOLED=
# Anyone signing up must enter this code. Share it with your friends.
INVITE_CODE=
# Vercel Blob private store token. Without it, files are stored in ./.uploads (dev only).
BLOB_READ_WRITE_TOKEN=
